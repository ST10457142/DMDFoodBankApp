<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="16dp" android:layout_marginBottom="0dp"
    app:cardCornerRadius="14dp" app:cardElevation="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:id="@+id/tvHubName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textStyle="bold" android:textColor="#1A3A2F" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tvHubAddress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="#4A4540" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tvHubHours" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="#4A4540" android:layout_marginBottom="2dp"/>
        <TextView android:id="@+id/tvHubPhone" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="#4A4540" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvHubStock" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textStyle="bold" android:layout_marginBottom="12dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDonateHere" android:layout_width="wrap_content"
            android:layout_height="42dp" android:text="@string/btn_donate_here"
            style="@style/Widget.DMD.Button.Outlined"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
