<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">
    <View android:id="@+id/tvUnreadDot" android:layout_width="8dp" android:layout_height="8dp"
        android:background="@drawable/bg_dot_green" android:layout_marginEnd="10dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvSender" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textStyle="bold" android:textColor="#1A1A1A"/>
        <TextView android:id="@+id/tvSubject" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#4A4540"/>
        <TextView android:id="@+id/tvPreview" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11sp"
            android:textColor="#6B6560" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnView"
        android:layout_width="wrap_content" android:layout_height="32dp"
        android:text="@string/btn_view" android:textSize="11sp"
        android:layout_marginStart="8dp" style="@style/Widget.DMD.Button.Dark"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete"
        android:layout_width="wrap_content" android:layout_height="32dp"
        android:text="@string/btn_delete" android:textSize="11sp"
        android:layout_marginStart="4dp" style="@style/Widget.DMD.Button.Danger"/>
</LinearLayout>
