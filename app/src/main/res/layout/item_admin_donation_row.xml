<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">
    <TextView android:id="@+id/tvType" android:layout_width="70dp"
        android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#4A4540"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvAmount" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textStyle="bold" android:textColor="#2D6A4F"/>
        <TextView android:id="@+id/tvFreq" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#6B6560"/>
    </LinearLayout>
    <TextView android:id="@+id/tvDate" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#6B6560"/>
</LinearLayout>
