    <!-- About -->
    <string name="about_title">Our Story</string>
    <string name="about_sub">Born from a belief that no South African should go to bed hungry.</string>
    <string name="about_body1">DMD Food Bank was founded in response to the food crisis amplified by the COVID-19 pandemic. What started as a neighbourhood initiative in Soweto quickly grew into a multi-hub organisation serving thousands of families across Gauteng.</string>
    <string name="about_body2">We partner with supermarkets, restaurants, farms, and generous donors to rescue surplus food and distribute it to those who need it most — with dignity and respect.</string>
    <string name="about_body3">We are a registered NPO (123-456) and PBO (930 012 345), and all monetary donations qualify for Section 18A tax deductions.</string>
    <string name="value_dignity_title">Dignity</string>
    <string name="value_dignity_body">Every person deserves to receive food with respect and without stigma.</string>
    <string name="value_community_title">Community</string>
    <string name="value_community_body">We believe communities are stronger when they lift each other up.</string>
    <string name="value_sustainability_title">Sustainability</string>
    <string name="value_sustainability_body">Rescuing food waste and reducing environmental impact is at our core.</string>

