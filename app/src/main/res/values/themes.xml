<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DMDFoodBank" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/earth</item>
        <item name="colorPrimaryVariant">@color/earth_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/warm</item>
        <item name="colorSecondaryVariant">@color/warm_dark</item>
        <item name="colorOnSecondary">@color/earth_dark</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="android:statusBarColor">@color/earth_dark</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:fontFamily">sans-serif</item>

        <!-- TextInputLayout -->
        <item name="textInputStyle">@style/Widget.DMD.TextInputLayout</item>

        <!-- Buttons -->
        <item name="materialButtonStyle">@style/Widget.DMD.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.DMD.BottomNavigation</item>
    </style>

    <!-- TextInputLayout -->
    <style name="Widget.DMD.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/border</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- Primary Button -->
    <style name="Widget.DMD.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/warm</item>
        <item name="android:textColor">@color/earth_dark</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.DMD.Button.Green" parent="Widget.DMD.Button">
        <item name="backgroundTint">@color/earth_light</item>
        <item name="android:textColor">@color/earth_dark</item>
    </style>

    <style name="Widget.DMD.Button.Dark" parent="Widget.DMD.Button">
        <item name="backgroundTint">@color/earth</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.DMD.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/earth</item>
        <item name="android:textColor">@color/earth</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.DMD.Button.Danger" parent="Widget.DMD.Button">
        <item name="backgroundTint">@color/error</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- BottomNavigation -->
    <style name="Widget.DMD.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="itemIconTint">@color/nav_icon_selector</item>
        <item name="itemTextColor">@color/nav_icon_selector</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Cards -->
    <style name="Widget.DMD.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Widget.DMD.Card.Hero" parent="Widget.DMD.Card">
        <item name="cardBackgroundColor">@color/earth_dark</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.DMD.Card.Stat" parent="Widget.DMD.Card">
        <item name="cardElevation">1dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="Widget.DMD.Card.Accent" parent="Widget.DMD.Card">
        <item name="cardBackgroundColor">@color/earth_light</item>
    </style>

    <!-- Text Appearances -->
    <style name="TextAppearance.DMD.Hero" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="TextAppearance.DMD.SectionTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/earth_dark</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DMD.StatNumber" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/earth</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DMD.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.DMD.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.DMD.Badge" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.DMD.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/earth_dark</item>
        <item name="titleTextColor">@color/white</item>
    </style>

    <!-- Admin theme -->
    <style name="Theme.DMDFoodBank.Admin" parent="Theme.DMDFoodBank">
        <item name="android:statusBarColor">@color/earth_dark</item>
        <item name="colorPrimaryDark">@color/earth_dark</item>
    </style>

    <!-- Login theme (no action bar, full screen feel) -->
    <style name="Theme.DMDFoodBank.Login" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/earth</item>
        <item name="colorSecondary">@color/warm</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/earth_dark</item>
        <item name="materialButtonStyle">@style/Widget.DMD.Button</item>
        <item name="textInputStyle">@style/Widget.DMD.TextInputLayout</item>
    </style>
</resources>
